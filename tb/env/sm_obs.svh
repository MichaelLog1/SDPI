import sm_core_isa_pkg::*;

class sm_obs;
    logic rst_n;
    logic en;
    logic restart;
    int cycle;
    logic [INSTRUCTION_WIDTH-1:0] instruction;
    logic [$clog2(IMEM_DEPTH)-1:0] pc_absolute;
    logic [DIV_INT_WIDTH-1:0] div_int;
    logic [DIV_FRAC_WIDTH-1:0] div_frac;
    logic [$clog2(IMEM_DEPTH)-1:0] pc_base;
    logic [$clog2(SM_WINDOW)-1:0] wrap_top;
    logic [$clog2(SM_WINDOW)-1:0] wrap_bottom;
    logic [2:0] jmp_pin;
    logic [$clog2(6)-1:0] sideset_count;
    logic sideset_opt;
    logic osr_shiftdir;
    logic isr_shiftdir;
    logic autopull;
    logic autopush;
    logic [4:0] isr_threshold;
    logic [4:0] osr_threshold;
    logic delay_from_y;
    logic [2:0] pin_out_base;
    logic [3:0] pin_out_count;
    logic [2:0] pin_set_base;
    logic [2:0] pin_set_count;
    logic [2:0] pin_in_base;
    logic [2:0] pin_sideset_base;
    logic [NUM_PINS-1:0] uio_in;
    logic [NUM_PINS-1:0] uio_out;
    logic [NUM_PINS-1:0] uio_oe;
    logic tx_en;
    logic [DATA_WIDTH-1:0] tx_data;
    logic rx_en;
    logic [DATA_WIDTH-1:0] rx_data;
    logic empty;
    logic full; 
    logic tx_fifo_wr_en;
    logic [DATA_WIDTH-1:0] tx_fifo_wr_data;
    logic tx_fifo_full;
    logic [$clog2(FIFO_DEPTH):0] tx_fifo_current_depth;
    logic tx_fifo_overflow;
    logic tx_fifo_underflow;
    logic tx_fifo_clear;
    logic rx_fifo_rd_en;
    logic [DATA_WIDTH-1:0] rx_fifo_rd_data;
    logic rx_fifo_empty;
    logic [$clog2(FIFO_DEPTH):0] rx_fifo_current_depth;
    logic rx_fifo_overflow;
    logic rx_fifo_underflow;
    logic rx_fifo_clear;
    logic [NUM_IRQ-1:0] irq_flags;
    logic [NUM_IRQ-1:0] irq_clear;
    logic [NUM_IRQ-1:0] irq_set;
    logic [NUM_IRQ-1:0] ext_irq_set;
    logic [NUM_IRQ-1:0] ext_irq_clr;

    function void sample(virtual sm_core_if vif);
        rst_n = vif.monitor_cb.rst_n;
        en = vif.monitor_cb.en;
        restart = vif.monitor_cb.restart;
        cycle = vif.monitor_cb.cycle;
        instruction = vif.monitor_cb.instruction;
        pc_absolute = vif.monitor_cb.pc_absolute;
        div_int = vif.monitor_cb.div_int;
        div_frac = vif.monitor_cb.div_frac;
        pc_base = vif.monitor_cb.pc_base;
        wrap_top = vif.monitor_cb.wrap_top;
        wrap_bottom = vif.monitor_cb.wrap_bottom;
        jmp_pin = vif.monitor_cb.jmp_pin;
        sideset_count = vif.monitor_cb.sideset_count;
        sideset_opt = vif.monitor_cb.sideset_opt;
        osr_shiftdir = vif.monitor_cb.osr_shiftdir;
        isr_shiftdir = vif.monitor_cb.isr_shiftdir;
        autopull = vif.monitor_cb.autopull;
        autopush = vif.monitor_cb.autopush;
        isr_threshold = vif.monitor_cb.isr_threshold;
        osr_threshold = vif.monitor_cb.osr_threshold;
        delay_from_y = vif.monitor_cb.delay_from_y;
        pin_out_base = vif.monitor_cb.pin_out_base;
        pin_out_count = vif.monitor_cb.pin_out_count;
        pin_set_base = vif.monitor_cb.pin_set_base;
        pin_set_count = vif.monitor_cb.pin_set_count;
        pin_in_base = vif.monitor_cb.pin_in_base;
        pin_sideset_base = vif.monitor_cb.pin_sideset_base;
        uio_in = vif.monitor_cb.uio_in;
        uio_out = vif.monitor_cb.uio_out;
        uio_oe = vif.monitor_cb.uio_oe;
        tx_en = vif.monitor_cb.tx_en;
        tx_data = vif.monitor_cb.tx_data;
        rx_en = vif.monitor_cb.rx_en;
        rx_data = vif.monitor_cb.rx_data;
        empty = vif.monitor_cb.empty;
        full = vif.monitor_cb.full; 
        tx_fifo_wr_en = vif.monitor_cb.tx_fifo_wr_en;
        tx_fifo_wr_data = vif.monitor_cb.tx_fifo_wr_data;
        tx_fifo_full = vif.monitor_cb.tx_fifo_full;
        tx_fifo_current_depth = vif.monitor_cb.tx_fifo_current_depth;
        tx_fifo_overflow = vif.monitor_cb.tx_fifo_overflow;
        tx_fifo_underflow = vif.monitor_cb.tx_fifo_underflow;
        tx_fifo_clear = vif.monitor_cb.tx_fifo_clear;
        rx_fifo_rd_en = vif.monitor_cb.rx_fifo_rd_en;
        rx_fifo_rd_data = vif.monitor_cb.rx_fifo_rd_data;
        rx_fifo_empty = vif.monitor_cb.rx_fifo_empty;
        rx_fifo_current_depth = vif.monitor_cb.rx_fifo_current_depth;
        rx_fifo_overflow = vif.monitor_cb.rx_fifo_overflow;
        rx_fifo_underflow = vif.monitor_cb.rx_fifo_underflow;
        rx_fifo_clear = vif.monitor_cb.rx_fifo_clear;
        irq_flags = vif.monitor_cb.irq_flags;
        irq_clear = vif.monitor_cb.irq_clear;
        irq_set = vif.monitor_cb.irq_set;
        ext_irq_set = vif.monitor_cb.ext_irq_set;
        ext_irq_clr = vif.monitor_cb.ext_irq_clr;
    endfunction

    function void to_string();
        $display("SM OBSERVED:\n");

        $display("\tLifecycle:");
        $display("\t\trst_n: %b\n", rst_n);
        $display("\t\ten: %d\n", en);
        $display("\t\trestart: %d\n", restart);
        $display("\t\tcycle: %d\n", cycle);

        $display("\tFetch");
        $display("\t\tinstruction: %d\n", instruction);
        $display("\t\tpc_absolute: %d\n", pc_absolute);

        $display("\tConfig");
        $display("\t\tdiv_int: %d\n", div_int);
        $display("\t\tdiv_frac: %d\n", div_frac);
        $display("\t\tpc_base: %d\n", pc_base);
        $display("\t\twrap_top: %d\n", wrap_top);
        $display("\t\twrap_bottom: %d\n", wrap_bottom);
        $display("\t\tjmp_pin: %d\n", jmp_pin);
        $display("\t\tsideset_count: %d\n", sideset_count);
        $display("\t\tsideset_opt: %d\n", sideset_opt);
        $display("\t\tosr_shiftdir: %d\n", osr_shiftdir);
        $display("\t\tisr_shiftdir: %d\n", isr_shiftdir);
        $display("\t\tautopull: %d\n", autopull);
        $display("\t\tautopush: %d\n", autopush);
        $display("\t\tisr_threshold: %d\n", isr_threshold);
        $display("\t\tosr_threshold: %d\n", osr_threshold);
        $display("\t\tdelay_from_y: %d\n", delay_from_y);
        $display("\t\tpin_out_base: %d\n", pin_out_base);
        $display("\t\tpin_out_count: %d\n", pin_out_count);
        $display("\t\tpin_set_base: %d\n", pin_set_base);
        $display("\t\tpin_set_count: %d\n", pin_set_count);
        $display("\t\tpin_in_base: %d\n", pin_in_base);
        $display("\t\tpin_sideset_base: %d\n", pin_sideset_base);

        $display("\tPins");
        $display("\t\tuio_in: %d\n", uio_in);
        $display("\t\tuio_out: %d\n", uio_out);
        $display("\t\tuio_oe: %d\n", uio_oe);

        $display("\tDUT FIFO Boundary");
        $display("\t\ttx_en: %d\n", tx_en);
        $display("\t\ttx_data: %d\n", tx_data);
        $display("\t\trx_en: %d\n", rx_en);
        $display("\t\trx_data: %d\n", rx_data);
        $display("\t\tempty: %d\n", empty);
        $display("\t\tfull: %d\n", full);

        $display("\tExternal FIFO");
        $display("\t\ttx_fifo_wr_en: %d\n", tx_fifo_wr_en);
        $display("\t\ttx_fifo_wr_data: %d\n", tx_fifo_wr_data);
        $display("\t\ttx_fifo_full: %d\n", tx_fifo_full);
        $display("\t\ttx_fifo_current_depth: %d\n", tx_fifo_current_depth);
        $display("\t\ttx_fifo_wr_en: %d\n", tx_fifo_wr_en);
        $display("\t\ttx_fifo_overflow: %d\n", tx_fifo_overflow);
        $display("\t\ttx_fifo_underflow: %d\n", tx_fifo_underflow);
        $display("\t\ttx_fifo_clear: %d\n", tx_fifo_clear);
        $display("\t\trx_fifo_rx_en: %d\n", rx_fifo_rd_en);
        $display("\t\trx_fifo_rd_data: %d\n", rx_fifo_rd_data);
        $display("\t\trx_fifo_empty: %d\n", rx_fifo_empty);
        $display("\t\trx_fifo_current_depth: %d\n", rx_fifo_current_depth);
        $display("\t\trx_fifo_overflow: %d\n", rx_fifo_overflow);
        $display("\t\trx_fifo_underflow: %d\n", rx_fifo_underflow);
        $display("\t\trx_fifo_clear: %d\n", rx_fifo_clear);

        $display("\tIRQ");
        $display("\t\tirq_flags: %d\n", irq_flags);
        $display("\t\tirq_clear: %d\n", irq_clear);
        $display("\t\tirq_set: %d\n", irq_set);
        $display("\t\text_irq_set: %d\n", ext_irq_set);
        $display("\t\text_irq_clr: %d\n", ext_irq_clr);
    endfunction

    function string to_string_short();
        decoded_instruction_t inst = decode(instruction, sideset_count, sideset_opt);
        return $sformatf("CYCLE: %d, PC: %d, OPCODE: %s, uio_out: %d, uio_oe: %d\n", cycle, pc_absolute, inst.instruction.opcode.name, uio_out, uio_oe);
    endfunction
endclass //sm_obs
